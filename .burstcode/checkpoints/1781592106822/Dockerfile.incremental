# ---------- Incremental build on top of hermes-agent:20260602 ----------
# Only patches 3 changed Python files.
# Build:  docker build -f Dockerfile.incremental -t docker.westsnow.cn/hermes-agent:20260608 .
#
FROM docker.westsnow.cn/hermes-agent:20260602

# Copy only the files that changed since the base image was built.
# This keeps the layer tiny and skips all apt/npm/uv dependency work.
COPY --chown=hermes:hermes run_agent.py /opt/hermes/run_agent.py
COPY --chown=hermes:hermes agent/chat_completion_helpers.py /opt/hermes/agent/chat_completion_helpers.py
COPY --chown=hermes:hermes gateway/platforms/api_server.py /opt/hermes/gateway/platforms/api_server.py

USER hermes
